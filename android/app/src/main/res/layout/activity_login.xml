<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_dark">

    <View
        android:id="@+id/ornament"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="-140dp"
        android:background="@drawable/bg_glow" />

    <ImageButton
        android:id="@+id/themeBtn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="14dp"
        android:background="@drawable/bg_pill_dark"
        android:contentDescription="@string/theme"
        android:padding="11dp"
        android:src="@drawable/ic_theme"
        android:tint="#EDEDF5" />

    <Button
        android:id="@+id/langBtn"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:background="@drawable/bg_pill_dark"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:minWidth="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="عربي  •  ENGLISH"
        android:textAllCaps="false"
        android:textColor="#EDEDF5"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="86dp"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/loginIcon"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/loginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:letterSpacing="0.16"
                android:text="LATCHI ARENA"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.34"
                android:text="A I"
                android:textColor="#5FD4FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/loginDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:lineSpacingExtra="5dp"
                android:text="@string/login_desc"
                android:textColor="#9A9AB0"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/login_card_title"
                    android:textColor="#EDEDF5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/login_card_body"
                    android:textColor="#8A8AA3"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/feat_models"
                        android:textColor="#7C4DFF"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/feat_compare"
                        android:textColor="#22D3EE"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/feat_free"
                        android:textColor="#34D399"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/startBtn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="26dp"
                android:backgroundTint="#7C4DFF"
                android:fontFamily="sans-serif-medium"
                android:text="@string/start_now"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/skipBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="@string/skip_login"
                android:textColor="#9A9AB0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/browserBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="@string/open_browser"
                android:textColor="#22D3EE"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/verText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:text="v1.1.0"
                android:textColor="#6D6D85"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
