<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05050C">

    <ImageView
        android:id="@+id/splashImg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_bg"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="54dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/splashLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.22"
            android:shadowColor="#B07C4DFF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="24"
            android:text="LATCHI"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:letterSpacing="0.36"
            android:text="ARENA  AI"
            android:textColor="#5FD4FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="44dp"
            android:layout_height="2dp"
            android:layout_marginTop="16dp"
            android:background="#7C4DFF" />

        <TextView
            android:id="@+id/splashTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/splash_tag"
            android:textColor="#CFCFE8"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="3dp"
            android:layout_marginTop="26dp"
            android:max="100"
            android:progressTint="#7C4DFF"
            android:progressBackgroundTint="#33FFFFFF" />
    </LinearLayout>
</FrameLayout>
